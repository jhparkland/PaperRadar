          },
          {
            "type": "paper",
            "pattern": "Paper Submission :\\s*\\d{1,2} [A-Z][a-z]+,? \\d{4}\\s*{{DATE}}"
          },
          {
            "type": "notification",
            "pattern": "Author Notification :\\s*{{DATE}}"
          },
          {
            "type": "camera-ready",
            "pattern": "Camera-Ready Papers :\\s*{{DATE}}"
          }
        ]
      }
    ]
  }
