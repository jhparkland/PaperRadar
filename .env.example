# Copy to .env for local runs. In GitHub Actions, set these as repository secrets instead.
# All are optional: without them `npm run remind` prints what it *would* send (dry run).

# --- Google Chat (incoming webhook) -----------------------------------------
# Google Chat > your space > Apps & integrations > Webhooks > Add webhook > copy URL
GOOGLE_CHAT_WEBHOOK_URL=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REMINDER_EMAIL_TO=
REMINDER_EMAIL_FROM=
